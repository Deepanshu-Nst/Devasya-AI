# =============================================================================
# Devasya AI — Frontend Environment Variables (.env.local)
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# --- Backend API URL ---
# Local development: http://localhost:8000
# Production (Render): https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (Frontend) ---
# Get from: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# ✅ Use the ANON key here — NOT the service_role key!
# The anon key is safe for browser use and respects Row Level Security (RLS)
# 🔐 NEVER put the service_role key in NEXT_PUBLIC_ variables
# Get from: Supabase → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...key
