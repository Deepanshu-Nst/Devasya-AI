# =============================================================================
# Devasya AI — Backend Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Server ---
DEBUG=False
API_PORT=8000
API_HOST=0.0.0.0

# --- Database (NeonDB / Supabase Postgres) ---
# Get this from: Supabase → Settings → Database → Connection String (Pooler)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Supabase ---
# Get from: Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# ⚠️  ANON key (safe to use as fallback, but limited by RLS)
SUPABASE_ANON_KEY=eyJ...

# ✅ REQUIRED for backend document uploads (bypasses RLS for server-side ops)
# Get from: Supabase → Settings → API → service_role key
# 🔐 NEVER expose this key to the frontend / browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LLM Provider (Groq) ---
LLM_PROVIDER=groq
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (HuggingFace) ---
# Optional — public HuggingFace inference API works without a key (rate limited)
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# --- CORS ---
# The frontend URL. Used to configure CORS on the backend.
# For Vercel: https://your-app.vercel.app
FRONTEND_URL=https://devasya-ai.vercel.app
CORS_ORIGINS=["http://localhost:3000","https://devasya-ai.vercel.app"]

# --- MCP Tools (Optional) ---
# GitHub API token for higher rate limits on github review tool
GITHUB_TOKEN=ghp_...
# SerpAPI key for richer web search (DuckDuckGo fallback used if not set)
SERPAPI_KEY=...

# --- Redis (Optional) ---
# REDIS_URL=redis://localhost:6379

# --- JWT (Legacy — no longer used, Supabase handles auth) ---
# These vars are no longer needed but kept for backward compatibility
JWT_SECRET_KEY=...
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
